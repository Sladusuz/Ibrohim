# Netlify > Site configuration > Environment variables ga shularni kiriting
BOT_TOKEN=            # @BotFather tokeni
ADMIN_IDS=            # Admin Telegram ID lari, vergul bilan (@userinfobot dan bilib oling)
WEBHOOK_SECRET=       # istalgan uzun tasodifiy qator (webhook himoyasi)

# ixtiyoriy to'lov usullari
PAYMENT_PROVIDER_TOKEN=   # @BotFather > Payments (Click / Payme / Uzum) tokeni, onlayn to'lov yoqiladi
CARD_NUMBER=              # karta o'tkazmasi yoqiladi
CARD_OWNER=
